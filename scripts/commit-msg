#!/usr/bin/env bash

# Portable Conventional Commits Hook
# Checks if the commit message follows the pattern: <type>(<scope>): <subject>

commit_msg_file=$1
commit_msg=$(cat "$commit_msg_file")

# Regex for Conventional Commits
pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\(.+\))?\!?: .+"

if ! [[ "$commit_msg" =~ $pattern ]]; then
    echo -e "\e[31m[ERROR] Invalid commit message format!\e[0m"
    echo -e "Your message: \e[33m$commit_msg\e[0m"
    echo -e "\nExpected format: \e[32mtype(scope): description\e[0m"
    echo -e "Allowed types: \e[36mfeat, fix, docs, style, refactor, perf, test, build, ci, chore, revert\e[0m"
    echo -e "\nExample: \e[32mfeat(api): add new endpoint\e[0m"
    exit 1
fi
